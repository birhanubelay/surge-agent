generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                 String   @id @default(cuid())
  name               String
  stadiumProximityM Int      @default(500)
  primaryLanguage    String   @default("en")
  supportedLanguages String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  forecasts          Forecast[]
}

model Forecast {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  matchId       String
  matchDate     DateTime
  multiplier    Float
  expectedSales Float
  confidence    Float
  riskFactors   String[]
  weatherFactor Float
  dayFactor     Float
  actualSales   Float?
  forecastError Float?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  approval      Approval?
  executionLogs ExecutionLog[]
}

model Approval {
  id          String   @id @default(cuid())
  forecastId  String   @unique
  forecast    Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  actions     Json
  status      String   @default("pending")
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
}

model ExecutionLog {
  id          String   @id @default(cuid())
  forecastId  String
  forecast    Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  actionType  String
  status      String
  payload     Json?
  errorMessage String?
  createdAt   DateTime @default(now())
}
