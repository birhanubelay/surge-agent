generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
  VIEWER
}
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(VIEWER)
  refreshToken  String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business      Business?
  @@index([email])
}
model Business {
  id                 String   @id @default(cuid())
  ownerId            String   @unique
  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  stadiumProximityM Int      @default(500)
  primaryLanguage    String   @default("en")
  supportedLanguages String[]
  address            String?
  phone              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  forecasts          Forecast[]
}

model Forecast {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  matchId       String
  matchDate     DateTime
  multiplier    Float
  expectedSales Float
  confidence    Float
  riskFactors   String[]
  weatherFactor Float
  dayFactor     Float
  actualSales   Float?
  forecastError Float?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  approval      Approval?
  executionLogs ExecutionLog[]
}

model Approval {
  id          String   @id @default(cuid())
  forecastId  String   @unique
  forecast    Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  actions     Json
  status      String   @default("pending")
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
}

model ExecutionLog {
  id          String   @id @default(cuid())
  forecastId  String
  forecast    Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  actionType  String
  status      String
  payload     Json?
  errorMessage String?
  createdAt   DateTime @default(now())
}
